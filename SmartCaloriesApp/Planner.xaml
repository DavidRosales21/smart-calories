<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartCaloriesApp.Planner"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">
    <Border
        Margin="20"
        Padding="35,40"
        BackgroundColor="{StaticResource CardBackground}"
        Stroke="#4A4A6A"
        StrokeThickness="1">
        <ScrollView>
            <Grid
                Padding="20"
                ColumnDefinitions="*, *"
                ColumnSpacing="10"
                RowDefinitions="Auto, 50,Auto,Auto,Auto,Auto,Auto,Auto,Auto , Auto ,Auto ,Auto"
                RowSpacing="15">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="18"
                    HorizontalOptions="Start"
                    Text="Today's Calorie Goal :"
                    VerticalOptions="Center" />
                <Label
                    x:Name="_txtCalories"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="Date :"
                    VerticalOptions="Center" />
                <DatePicker
                    x:Name="_mealDatePicker"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,25,0,0"
                    Format="MMM dd"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />


                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="Breakfast:"
                    VerticalOptions="Center" />
                <Picker
                    x:Name="_breakfastPicker"
                    Title="Select Meal"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalOptions="Fill" />

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="Snack:"
                    VerticalOptions="Center" />
                <Picker
                    x:Name="_snackPicker"
                    Title="Select Meal"
                    Grid.Row="3"
                    Grid.Column="1"
                    HorizontalOptions="Fill" />

                <Label
                    Grid.Row="4"
                    Grid.Column="0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="Lunch:"
                    VerticalOptions="Center" />
                <Picker
                    x:Name="_lunchPicker"
                    Title="Select Meal"
                    Grid.Row="4"
                    Grid.Column="1"
                    HorizontalOptions="Fill" />

                <Label
                    Grid.Row="5"
                    Grid.Column="0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="Dinner:"
                    VerticalOptions="Center" />
                <Picker
                    x:Name="_dinnerPicker"
                    Title="Select Meal"
                    Grid.Row="5"
                    Grid.Column="1"
                    HorizontalOptions="Fill" />


                <Label
                    Grid.Row="6"
                    Grid.Column="0"
                    FontSize="16"
                    Text="Workout today?"
                    VerticalOptions="Center" />

                <HorizontalStackLayout Grid.Row="6" Grid.Column="1">
                    <RadioButton
                        x:Name="_radioYes"
                        CheckedChanged="_radioYes_CheckedChanged"
                        Content="Yes"
                        GroupName="WorkoutDay" />
                    <RadioButton
                        x:Name="_radioNo"
                        CheckedChanged="_radioNo_CheckedChanged"
                        Content="No"
                        GroupName="WorkoutDay" />
                </HorizontalStackLayout>

                <Label
                    x:Name="_workoutLabel"
                    Grid.Row="7"
                    Grid.Column="0"
                    FontSize="16"
                    IsVisible="False"
                    Text="Workout:"
                    VerticalOptions="Center" />

                <Picker
                    x:Name="_workoutPicker"
                    Title="Select Workout"
                    Grid.Row="7"
                    Grid.Column="1"
                    HorizontalOptions="Fill"
                    IsVisible="False" />


                <Label
                    Grid.Row="8"
                    Grid.Column="0"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="Nutritional Value:"
                    VerticalOptions="Center" />
                <Label
                    x:Name="_nutritionalValueLabel"
                    Grid.Row="8"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Start"
                    Text="0 cals"
                    VerticalOptions="Center" />

                <Button
                    x:Name="_btnPlannerSave"
                    Grid.Row="9"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0"
                    BackgroundColor="{StaticResource BtnPrimary}"
                    Clicked="_btnPlannerSave_OnClicked"
                    HorizontalOptions="Center"
                    Text="Save"
                    WidthRequest="150" />
                <!--  the list for the days and meals that the user will pick  -->
                <Border
                    Grid.Row="10"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0"
                    Padding="10"
                    Stroke="Gray"
                    StrokeThickness="1">
                    <VerticalStackLayout>
                        <!--  table header  -->
                        <Grid
                            Padding="10"
                            BackgroundColor="Blue"
                            ColumnDefinitions="*, *, *, *, *, *, *">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                Text="Date" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                Text="Meals" />
                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                Text="Workout" />
                            <Label
                                Grid.Column="3"
                                FontAttributes="Bold"
                                Text="Cal Eaten" />
                            <Label
                                Grid.Column="4"
                                FontAttributes="Bold"
                                Text="Cal Burned" />
                            <Label
                                Grid.Column="5"
                                FontAttributes="Bold"
                                Text="Net Cal" />
                            <Label
                                Grid.Column="6"
                                FontAttributes="Bold"
                                Text="Status" />
                        </Grid>
                        <CollectionView x:Name="_mealPlansList" HeightRequest="250">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Margin="0,5,0,5" Padding="10">
                                        <Grid ColumnDefinitions="*, *, *, *, *,  *, *">
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                Text="{Binding Date, StringFormat='{0:MMM dd}'}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Meals}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Workout}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding CaloriesEaten}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="4"
                                                Text="{Binding CaloriesBurned}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="5"
                                                Text="{Binding NetCalories}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="6"
                                                Text="{Binding Status}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout
                    x:Name="_navigationBtn"
                    Grid.Row="11"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0"
                    HorizontalOptions="Center"
                    IsVisible="False"
                    Spacing="10">
                    <Button
                        x:Name="_btnGoToRecipes"
                        BackgroundColor="{StaticResource BtnSecondary}"
                        Clicked="_btnGoToRecipes_OnClicked"
                        Text="Browse Recipes" />
                    <Button
                        x:Name="_btnGoToWorkOut"
                        BackgroundColor="{StaticResource BtnSecondary}"
                        Clicked="_btnGoToWorkOut_OnClicked"
                        Text="Browse Workout" />


                </HorizontalStackLayout>

            </Grid>
        </ScrollView>
    </Border>
</ContentPage>