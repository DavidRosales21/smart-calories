<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SmartCaloriesApp.Planner"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <Grid Padding="32,24,32,40">

            <Frame
                Padding="32"
                BackgroundColor="{StaticResource CardBackground}"
                BorderColor="{StaticResource BorderColor}"
                CornerRadius="24"
                HasShadow="False"
                HorizontalOptions="Fill"
                MaximumWidthRequest="1100">

                <Grid
                    HorizontalOptions="Fill"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="20">

                    <!--  PAGE HEADER  -->
                    <VerticalStackLayout Grid.Row="0" Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            Text="Meal Planner"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            FontSize="14"
                            Text="Plan your meals, track calories, and save your daily progress."
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!--  TOP SECTION  -->
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16">

                        <!--  CALORIE GOAL  -->
                        <Frame
                            Padding="18"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="6">
                                <Label
                                    FontSize="13"
                                    Text="Today's Calorie Goal"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    x:Name="_txtCalories"
                                    FontAttributes="Bold"
                                    FontSize="24"
                                    TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Frame>

                        <!--  DATE  -->
                        <Frame
                            Grid.Column="1"
                            Padding="18"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontSize="13"
                                    Text="Plan Date"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Frame
                                    Padding="12,6"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    BorderColor="{StaticResource BorderColor}"
                                    CornerRadius="14"
                                    HasShadow="False">

                                    <DatePicker
                                        x:Name="_mealDatePicker"
                                        BackgroundColor="Transparent"
                                        Format="MMM dd"
                                        HorizontalOptions="Fill"
                                        TextColor="{StaticResource TextPrimary}" />
                                </Frame>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!--  MEALS TITLE  -->
                    <VerticalStackLayout Grid.Row="2" Spacing="4">

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Meals"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            FontSize="13"
                            Text="Choose your meals for the day."
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!--  MEALS  -->
                    <Grid
                        Grid.Row="3"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="16">

                        <!--  BREAKFAST  -->
                        <Frame
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="16"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Breakfast"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Picker
                                    x:Name="_breakfastPicker"
                                    Title="Select Meal"
                                    HorizontalOptions="Fill"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Frame>

                        <!--  SNACK  -->
                        <Frame
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="16"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Snack"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Picker
                                    x:Name="_snackPicker"
                                    Title="Select Meal"
                                    HorizontalOptions="Fill"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Frame>

                        <!--  LUNCH  -->
                        <Frame
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="16"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Lunch"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Picker
                                    x:Name="_lunchPicker"
                                    Title="Select Meal"
                                    HorizontalOptions="Fill"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Frame>

                        <!--  DINNER  -->
                        <Frame
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="16"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="Dinner"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Picker
                                    x:Name="_dinnerPicker"
                                    Title="Select Meal"
                                    HorizontalOptions="Fill"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!--  WORKOUT  -->
                    <Frame
                        Grid.Row="4"
                        Padding="18"
                        BackgroundColor="{StaticResource PageBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <VerticalStackLayout Spacing="14">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Workout"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="Did you work out today?"
                                    TextColor="{StaticResource TextSecondary}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <HorizontalStackLayout Spacing="20">
                                <RadioButton
                                    x:Name="_radioYes"
                                    CheckedChanged="_radioYes_CheckedChanged"
                                    Content="Yes"
                                    GroupName="WorkoutDay" />
                                <RadioButton
                                    x:Name="_radioNo"
                                    CheckedChanged="_radioNo_CheckedChanged"
                                    Content="No"
                                    GroupName="WorkoutDay" />
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="130,*" ColumnSpacing="12">

                                <Label
                                    x:Name="_workoutLabel"
                                    Grid.Column="0"
                                    FontSize="15"
                                    IsVisible="False"
                                    Text="Workout:"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center" />

                                <Picker
                                    x:Name="_workoutPicker"
                                    Title="Select Workout"
                                    Grid.Column="1"
                                    HorizontalOptions="Fill"
                                    IsVisible="False"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource TextSecondary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!--  NUTRITION VALUE  -->
                    <Frame
                        Grid.Row="5"
                        Padding="18"
                        BackgroundColor="{StaticResource HeaderBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Nutritional Value"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="_nutritionalValueLabel"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="0 cals"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <!--  SAVE BUTTON  -->
                    <Button
                        x:Name="_btnPlannerSave"
                        Grid.Row="6"
                        BackgroundColor="{StaticResource BtnPrimary}"
                        Clicked="_btnPlannerSave_OnClicked"
                        CornerRadius="16"
                        FontAttributes="Bold"
                        FontSize="18"
                        HeightRequest="56"
                        HorizontalOptions="Fill"
                        Text="Save Plan"
                        TextColor="{StaticResource TextPrimary}" />

                    <!--  SAVED PLANS TITLE  -->
                    <VerticalStackLayout Grid.Row="7" Spacing="4">

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Saved Plans"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            FontSize="13"
                            Text="Review your saved meals and calorie summary."
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!--  SAVED PLANS LIST  -->
                    <Frame
                        Grid.Row="8"
                        Padding="12"
                        BackgroundColor="{StaticResource PageBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <VerticalStackLayout Spacing="10">

                            <!--  TABLE HEADER  -->
                            <Grid
                                Padding="12,10"
                                BackgroundColor="{StaticResource HeaderBackground}"
                                ColumnDefinitions="*,*,*,*,*,*,*">

                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Date"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Meals"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Workout"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Grid.Column="3"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Cal Eaten"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Grid.Column="4"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Cal Burned"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Grid.Column="5"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Net Cal"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Grid.Column="6"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Status"
                                    TextColor="{StaticResource TextPrimary}" />
                            </Grid>

                            <CollectionView x:Name="_mealPlansList" HeightRequest="250">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame
                                            Margin="0,4,0,4"
                                            Padding="12"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            BorderColor="{StaticResource BorderColor}"
                                            CornerRadius="14"
                                            HasShadow="False">

                                            <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                                <Label
                                                    Grid.Column="0"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="{Binding Date, StringFormat='{0:MMM dd}'}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Meals}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="2"
                                                    FontSize="12"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding Workout}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="3"
                                                    FontSize="12"
                                                    Text="{Binding CaloriesEaten}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="4"
                                                    FontSize="12"
                                                    Text="{Binding CaloriesBurned}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="5"
                                                    FontSize="12"
                                                    Text="{Binding NetCalories}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Grid.Column="6"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="{Binding Status}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <!--  NAVIGATION BUTTONS  -->
                    <HorizontalStackLayout
                        x:Name="_navigationBtn"
                        Grid.Row="9"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Spacing="12">

                        <Button
                            x:Name="_btnGoToRecipes"
                            BackgroundColor="{StaticResource BtnSecondary}"
                            Clicked="_btnGoToRecipes_OnClicked"
                            CornerRadius="14"
                            HeightRequest="50"
                            Text="Browse Recipes"
                            TextColor="{StaticResource TextPrimary}" />

                        <Button
                            x:Name="_btnGoToWorkOut"
                            BackgroundColor="{StaticResource BtnSecondary}"
                            Clicked="_btnGoToWorkOut_OnClicked"
                            CornerRadius="14"
                            HeightRequest="50"
                            Text="Browse Workout"
                            TextColor="{StaticResource TextPrimary}" />
                    </HorizontalStackLayout>

                </Grid>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>