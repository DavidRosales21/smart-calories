<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SmartCaloriesApp.DayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <Grid Padding="32,24,32,40">

            <Frame
                Padding="32"
                BackgroundColor="{StaticResource CardBackground}"
                BorderColor="{StaticResource BorderColor}"
                CornerRadius="24"
                HasShadow="False"
                HorizontalOptions="Fill"
                MaximumWidthRequest="1100">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto, Auto" RowSpacing="20">

                    <!--  PAGE HEADER  -->
                    <VerticalStackLayout Grid.Row="0" Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            Text="Day Overview"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            FontSize="14"
                            Text="View your selected recipe, ingredients, and workout for the day."
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!--  DATE SECTION  -->
                    <Frame
                        Grid.Row="1"
                        Padding="18"
                        BackgroundColor="{StaticResource PageBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Choose Date"
                                TextColor="{StaticResource TextPrimary}" />

                            <DatePicker
                                x:Name="_pckDay"
                                BackgroundColor="{StaticResource CardBackground}"
                                DateSelected="OnDateSelected"
                                HorizontalOptions="Fill"
                                TextColor="{StaticResource TextPrimary}" />
                                
                            <Button Text="Load Plan"
                                    x:Name="_btnLoadPlan"
                                    BackgroundColor="{StaticResource BtnPrimary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    CornerRadius="14"
                                    Clicked="OnLoadPlan"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!--  RECIPE NAVIGATION  -->
                    <Frame
                        Grid.Row="2"
                        Padding="18"
                        BackgroundColor="{StaticResource HeaderBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <Grid ColumnDefinitions="70,*,70" ColumnSpacing="12">

                            <Button
                                x:Name="_btnPrev"
                                Grid.Column="0"
                                Margin="0"
                                BackgroundColor="{StaticResource BtnPrimary}"
                                Clicked="OnPrevReciepe"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="22"
                                HeightRequest="48"
                                Text="&lt;"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                x:Name="_txtMeal"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                Text="Recipe"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalTextAlignment="Center" />

                            <Button
                                x:Name="_btnNext"
                                Grid.Column="2"
                                Margin="0"
                                BackgroundColor="{StaticResource BtnPrimary}"
                                Clicked="OnNextReciepe"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="22"
                                HeightRequest="48"
                                Text="&gt;"
                                TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                    </Frame>

                    
                    <!-- THE RECIEPE IIMAGE -->
                    
                    <Image x:Name="_mealImage"
                           Grid.Row="3"
                           HeightRequest="200"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           IsVisible="True"
                           />
                    
                    <!--  RECIPE DETAILS  -->
                    <VerticalStackLayout Grid.Row="4" Spacing="8">

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Recipe Details"
                            TextColor="{StaticResource TextPrimary}" />

                        <Frame
                            Padding="18"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <Label
                                x:Name="_txtReciepe"
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource TextPrimary}" />
                        </Frame>
                    </VerticalStackLayout>

                    <!--  INGREDIENTS TITLE  -->
                    <Label
                        Grid.Row="5"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Ingredients"
                        TextColor="{StaticResource TextPrimary}" />

                    <!--  INGREDIENTS LIST  -->
                    <Frame
                        Grid.Row="6"
                        Padding="12"
                        BackgroundColor="{StaticResource PageBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <CollectionView x:Name="_lstIngredients" HeightRequest="220">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10,8" Margin="0,4" 
                                           BackgroundColor="{StaticResource CardBackground}"
                                           BorderColor="{StaticResource BorderColor}"
                                           CornerRadius="10"
                                           HasShadow="False">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   FontSize="15"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Quantity}"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   FontSize="14"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        
                        
                    </Frame>

                    <!--  WORKOUT TITLE  -->
                    <Label
                        Grid.Row="7"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Workout"
                        TextColor="{StaticResource TextPrimary}" />

                    <!--  WORKOUT DETAILS  -->
                    <Frame
                        Grid.Row="8"
                        Padding="18"
                        BackgroundColor="{StaticResource PageBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <Label
                            x:Name="_lstWorkOut"
                            FontSize="15"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource TextPrimary}" />
                    </Frame>

                </Grid>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>