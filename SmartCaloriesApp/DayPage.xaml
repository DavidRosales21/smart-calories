<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCaloriesApp.DayPage"
             BackgroundColor="{StaticResource PageBackground}">

    <Border Margin="20"
        Padding="35, 40"
        Stroke="#4A4A6A" 
        StrokeThickness="1"
        BackgroundColor="{StaticResource CardBackground}">
        <Grid RowDefinitions="auto,auto,*,auto,*,auto,*">
            <DatePicker x:Name="_pckDay" 
                HorizontalOptions="Center"
                Grid.Row="0"
                Margin="20"
                BackgroundColor="#EFECE3"
                TextColor="Black"
                DateSelected="OnDateSelected" >
            </DatePicker>
            <Border Grid.Row="1"
                HorizontalOptions="Center" 
                Background="{StaticResource HeaderBackground}" 
                Stroke="#8FABe4">
                <HorizontalStackLayout>
                    <Button Text="&lt;" 
                        BackgroundColor="Red" 
                        TextColor="#EFECE3" 
                        FontSize="23"
                        Clicked="OnPrevReciepe"
                            Margin="5"/>

                    <Label x:Name="_txtMeal"
                       Text="Reciepe" 
                       Padding="10"
                       TextColor="#EFECE3" 
                       FontSize="26" VerticalTextAlignment="Center"/>

                    <Button Text=">" 
                        BackgroundColor="Red"
                        TextColor="#EFECE3" 
                        FontSize="26"
                        Clicked="OnNextReciepe"
                            Margin="5"/>
                </HorizontalStackLayout>

            </Border>
            <Border Grid.Row="2"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
                <Label x:Name="_txtReciepe"/>
            </Border>
            <Border Grid.Row="3"
                HorizontalOptions="Center" 
                Background="{StaticResource HeaderBackground}"  
                Stroke="#8FABe4">
                <Label Text="Ingredients" 
                   Padding="10"
                   TextColor="#EFECE3" 
                   FontSize="23"/>
            </Border>

            <Border
                Grid.Row="4"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
                <CollectionView x:Name="_lstIngredients"/>
            </Border>
            <Border Grid.Row="5"
                HorizontalOptions="Center" 
                Background="{StaticResource HeaderBackground}"  
                Stroke="#8FABe4">
                <Label Text="Workout" 
                   Padding="10"
                   TextColor="#EFECE3" 
                   FontSize="23"/>
            </Border>
            <Border
                Grid.Row="6"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
                <Label x:Name="_lstWorkOut"/>
            </Border>
        </Grid>
    </Border>
</ContentPage>