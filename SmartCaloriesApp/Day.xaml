<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCaloriesApp.Day">

    <Grid RowDefinitions="auto,auto,*,auto,*,auto,*">
        <Picker x:Name="_pckDay" 
            Grid.Row="0"
            Margin="20"
            BackgroundColor="#EFECE3"
            TextColor="Black">
        </Picker>
        <Border Grid.Row="1"
                HorizontalOptions="Center" 
                Background="#8FABe4" 
                Stroke="#8FABe4">
            <Label Text="Ingredients" 
                   Padding="10"
                   TextColor="#EFECE3" 
                   FontSize="26"/>
        </Border>

        <Border
                Grid.Row="2"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
            <CollectionView x:Name="_lstIngredients"/>
        </Border>
        <Border Grid.Row="3"
                HorizontalOptions="Center" 
                Background="#8FABe4" 
                Stroke="#8FABe4">
            <Label Text="Recipe" 
                   Padding="10"
                   TextColor="#EFECE3" 
                   FontSize="26"/>

        </Border>
        <Border Grid.Row="4"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
            <Label x:Name="_txtReciepe"/>
        </Border>
        <Border Grid.Row="5"
                HorizontalOptions="Center" 
                Background="#8FABe4" 
                Stroke="#8FABe4">
            <Label Text="Workout" 
                   Padding="10"
                   TextColor="#EFECE3" 
                   FontSize="26"/>
        </Border>
        <Border
                Grid.Row="6"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
            <CollectionView x:Name="_lstWorkOut"/>
        </Border>
    </Grid>
</ContentPage>