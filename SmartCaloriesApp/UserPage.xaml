<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SmartCaloriesApp.UserPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <Grid Padding="32,24,32,40">
            <Border
                Padding="36"
                Background="{StaticResource CardBackground}"
                HorizontalOptions="Center"
                MaximumWidthRequest="980"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <!--  Header  -->
                    <VerticalStackLayout
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,28"
                        Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            Text="User Information"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            FontSize="14"
                            Text="Enter your details to build your calorie plan."
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!--  Name  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Full Name"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="14,8"
                        Background="{StaticResource PageBackground}"
                        HeightRequest="80"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="_txtName"
                            BackgroundColor="Transparent"
                            Placeholder="Enter your name"
                            PlaceholderColor="{StaticResource TextSecondary}"
                            TextColor="{StaticResource TextPrimary}" />
                    </Border>

                    <!--  Gender  -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Gender"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />

                    <HorizontalStackLayout
                        Grid.Row="2"
                        Grid.Column="1"
                        RadioButtonGroup.GroupName="GenderGroup"
                        Spacing="16"
                        VerticalOptions="Center">

                        <Border
                            Padding="16,12"
                            Background="{StaticResource PageBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <RadioButton x:Name="_radioMale" IsChecked="True" />
                                <Image
                                    HeightRequest="34"
                                    Source="male.png"
                                    WidthRequest="34" />
                                <Label
                                    FontSize="15"
                                    Text="Male"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border
                            Padding="16,12"
                            Background="{StaticResource PageBackground}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <RadioButton x:Name="_radioFemale" />
                                <Image
                                    HeightRequest="34"
                                    Source="female.png"
                                    WidthRequest="34" />
                                <Label
                                    FontSize="15"
                                    Text="Female"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <!--  Age  -->
                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Age"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />


                    <Border
                        Grid.Row="3"
                        Grid.Column="1"
                        Padding="14,0"
                        Background="{StaticResource PageBackground}"
                        HeightRequest="80"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Picker
                            x:Name="_pkrAge"
                            Title="Select age"
                            Grid.Row="3"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource PageBackground}"
                            FontSize="16"
                            HeightRequest="60"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  Current Weight  -->
                    <Label
                        Grid.Row="4"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Current Weight"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />

                    <Grid
                        Grid.Row="4"
                        Grid.Column="1"
                        ColumnDefinitions="*,72"
                        ColumnSpacing="12">

                        <Border
                            Padding="14,8"
                            Background="{StaticResource PageBackground}"
                            HeightRequest="70"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="_txtCrtWeight"
                                BackgroundColor="Transparent"
                                HeightRequest="54"
                                Keyboard="Numeric"
                                Placeholder="Enter weight"
                                PlaceholderColor="{StaticResource TextSecondary}"
                                TextColor="{StaticResource TextPrimary}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{StaticResource HeaderBackground}"
                            HeightRequest="54"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                Text="kg"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!--  Target Weight  -->
                    <Label
                        Grid.Row="5"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Target Weight"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />

                    <Grid
                        Grid.Row="5"
                        Grid.Column="1"
                        ColumnDefinitions="*,72"
                        ColumnSpacing="12">

                        <Border
                            Padding="14,8"
                            Background="{StaticResource PageBackground}"
                            HeightRequest="70"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="_txtTargetWeight"
                                BackgroundColor="Transparent"
                                Keyboard="Numeric"
                                Placeholder="Enter target weight"
                                PlaceholderColor="{StaticResource TextSecondary}"
                                TextColor="{StaticResource TextPrimary}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{StaticResource HeaderBackground}"
                            HeightRequest="54"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                Text="kg"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!--  Height  -->
                    <Label
                        Grid.Row="6"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Height"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />

                    <Grid
                        Grid.Row="6"
                        Grid.Column="1"
                        ColumnDefinitions="*,72"
                        ColumnSpacing="12">

                        <Border
                            Padding="14,8"
                            Background="{StaticResource PageBackground}"
                            HeightRequest="70"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="_txtHeight"
                                BackgroundColor="Transparent"
                                Keyboard="Numeric"
                                Placeholder="Enter height"
                                PlaceholderColor="{StaticResource TextSecondary}"
                                TextColor="{StaticResource TextPrimary}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{StaticResource HeaderBackground}"
                            HeightRequest="54"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                Text="cm"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!--  Activity  -->
                    <Label
                        Grid.Row="7"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Daily Activity"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Row="7"
                        Grid.Column="1"
                        Padding="14,0"
                        Background="{StaticResource PageBackground}"
                        HeightRequest="80"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Picker
                            x:Name="_pkrActivity"
                            Title="Select activity level"
                            BackgroundColor="{StaticResource PageBackground}"
                            FontSize="14"
                            HeightRequest="60"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Sedentary (Little to no exercise)</x:String>
                                <x:String>Lightly active (light exercise 1-3 days/week)</x:String>
                                <x:String>Moderately active (moderate exercise 3-5 days/week)</x:String>
                                <x:String>Very active (hard exercise 6-7 days a week)</x:String>
                                <x:String>Extra active (very hard exercise/physical job)</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <!--  Goal Pace  -->
                    <Label
                        Grid.Row="8"
                        Grid.Column="0"
                        FontSize="16"
                        Text="Goal Pace"
                        TextColor="{StaticResource TextPrimary}"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Row="8"
                        Grid.Column="1"
                        Padding="14,0"
                        Background="{StaticResource PageBackground}"
                        HeightRequest="80"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Picker
                            x:Name="_pkrDays"
                            Title="Select your pace"
                            BackgroundColor="{StaticResource PageBackground}"
                            FontSize="14"
                            HeightRequest="60"
                            HorizontalOptions="Fill"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Slow and Steady(26 weeks)</x:String>
                                <x:String>Go with the flow(15 weeks)</x:String>
                                <x:String>Lets go crazy (6 weeks)</x:String>
                                <x:String>Kill me(1 week)</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <!--  Submit  -->
                    <Button
                        Grid.Row="10"
                        Grid.ColumnSpan="2"
                        Margin="0,30,0,0"
                        BackgroundColor="{StaticResource BtnPrimary}"
                        Clicked="OnSubmit"
                        CornerRadius="16"
                        FontAttributes="Bold"
                        FontSize="18"
                        HeightRequest="56"
                        Text="Submit"
                        TextColor="{StaticResource TextPrimary}" />

                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>