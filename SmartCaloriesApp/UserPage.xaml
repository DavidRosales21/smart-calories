<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCaloriesApp.UserInfo_1">
    <ScrollView>
        <Grid Background="Black" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Text="User Information" Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="Center" FontSize="Medium"></Label>
            <Label Text="Name :" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"></Label>
            <Entry Grid.Row="1" Grid.Column="1" VerticalOptions="Center"></Entry>
            <Label Text="Sex :" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" ></Label>
            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" VerticalOptions="Center">
                <RadioButton>
                    <RadioButton.Content>
                        <Image Source="male.png" HeightRequest="50" WidthRequest="50" />
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton>
                    <RadioButton.Content>
                        <Image Source="female.png" HeightRequest="50" WidthRequest="50"/>
                    </RadioButton.Content>
                </RadioButton>
            </HorizontalStackLayout>
            <Label Text="Age :" Grid.Row="3" VerticalOptions="Center"></Label>
            <Picker x:Name="_pkrAge" FontSize="15" WidthRequest="200" Grid.Row="3" Grid.Column="1" HorizontalOptions="Start" VerticalOptions="Center" />
            <Label Text="Current Weight :" Grid.Row="4" VerticalOptions="Center"></Label>
            <HorizontalStackLayout Grid.Row="4" Grid.Column="1">
                <Entry  HorizontalOptions="Start"/>
                <Label HorizontalOptions="Center" Text="Kg" VerticalOptions="Center"></Label>
            </HorizontalStackLayout>
            <Label Text="Target Weight :" Grid.Row="5" VerticalOptions="Center"></Label>
            <HorizontalStackLayout Grid.Row="5" Grid.Column="1">
               <Entry  VerticalOptions="Center"></Entry>
                <Label HorizontalOptions="Center" Text="Kg" VerticalOptions="Center"></Label>
            </HorizontalStackLayout>
            <Label Text="Height : " Grid.Row="6" VerticalOptions="Center"></Label>
            <HorizontalStackLayout Grid.Row="6" Grid.Column="1">
                <Entry ></Entry>
                <Label HorizontalOptions="Center" Text="ft" VerticalOptions="Center"></Label>
            </HorizontalStackLayout>
            <Label Grid.Row="7" Text="Level : " VerticalOptions="Center"></Label>
            <Picker Grid.Row="7" Grid.Column="1" Background="LightBlue">
                <Picker.Items>
                    <x:String>Slow and Steady</x:String>
                    <x:String>Let's do this smoothly</x:String>
                    <x:String>Fast and Furious</x:String>
                </Picker.Items>
            </Picker>
            <Label Grid.Row="8" Text="Activity" VerticalOptions="Center"></Label>
            <Picker Grid.Row="8" Grid.Column="1" Background="LightBlue">
                <Picker.Items>
                    <x:String>I am Lazy !!! </x:String>
                    <x:String>Hey, I do workout here and there</x:String>
                    <x:String>I am the next Arnold Schwarzenegger !!</x:String>
                </Picker.Items>
            </Picker>
            <Entry Grid.Row="12" Grid.ColumnSpan="2"></Entry>
            <Button Grid.Row="13" Grid.ColumnSpan="2" Text="Submit" FontSize="Medium" Background="LightBlue" ></Button>


        </Grid>
    </ScrollView>
</ContentPage>