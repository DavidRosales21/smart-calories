<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCaloriesApp.Recipes_4">

    <Grid RowDefinitions="auto,auto,*,auto,*">
        <Picker Grid.Row="0"
            Margin="20"
            BackgroundColor="#EFECE3"
            TextColor="Black">

            <Picker.Items>
                <x:String>1</x:String>
                <x:String>2</x:String>
            </Picker.Items>
        </Picker>
        <Border Grid.Row="1"
                HorizontalOptions="Center" 
                Background="#8FABe4" 
                Stroke="#8FABe4">
            <Label Text="Ingredients" 
                       TextColor="#EFECE3" 
                       FontSize="26"/>
        </Border>

        <Border
                Grid.Row="2"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
            <CollectionView/>
        </Border>
        <Border Grid.Row="3"
                HorizontalOptions="Center" 
                Background="#8FABe4" 
                Stroke="#8FABe4">
            <Label Text="Recipe" 
                   TextColor="#EFECE3" 
                   FontSize="26"/>

        </Border>
        <Border Grid.Row="4"
                Margin="20"
                StrokeThickness="2"
                Stroke="#8FABD4">
            <CollectionView/>
        </Border>
    </Grid>
</ContentPage>