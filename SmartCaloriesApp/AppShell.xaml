<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartCaloriesApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SmartCaloriesApp"
    Title="SmartCaloriesApp">

    <TabBar>
        <Tab Title="User">
            <ShellContent
        ContentTemplate="{DataTemplate local:UserPage}"
        Route="UserPage" />
        </Tab>
        <Tab Title="Planner">
            <ShellContent
               ContentTemplate="{DataTemplate local:Planner}"
                Route="Planner" />
        </Tab>
        <Tab Title="Shopping List">
            <ShellContent
    ContentTemplate="{DataTemplate local:ShoppingList}"
    Route="ShoppingList" />
        </Tab>
        <Tab Title="Day">
            <ShellContent
ContentTemplate="{DataTemplate local:DayPage}"
Route="Day" />
        </Tab>
    </TabBar>
</Shell>
