<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartCaloriesApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SmartCaloriesApp"
    Title="SmartCaloriesApp">

    <TabBar>
        <Tab Title="User Info">
            <ShellContent
        ContentTemplate="{DataTemplate local:UserInfo_1}"
        Route="UserInfo_1" />
        </Tab>
        <Tab Title="Meals">
            <ShellContent
               ContentTemplate="{DataTemplate local:MealPlanner_2}"
                Route="MealPlanner_2" />
        </Tab>
        <Tab Title="Shopping List">
            <ShellContent
    ContentTemplate="{DataTemplate local:ShoppingList_3}"
    Route="ShoppingList_3" />
        </Tab>
        <Tab Title="Recipes">
            <ShellContent
ContentTemplate="{DataTemplate local:Recipes_4}"
Route="Recipes" />
        </Tab>
    </TabBar>
</Shell>
