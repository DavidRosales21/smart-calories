<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCaloriesApp.ShoppingList">
    <Grid RowDefinitions="Auto, Auto ,*" ColumnDefinitions="*,*"
          Margin="20">
        <Border HorizontalOptions="Center" Background="#8FABe4" Stroke="#8FABe4" Grid.Row="0" Grid.ColumnSpan="2" Padding="10">
            <Label Text="Shopping List" TextColor="#EFECE3" FontSize="26"/>
        </Border>
        <HorizontalStackLayout Margin="20"  Grid.Row="1" Grid.Column="0" HorizontalOptions="Center">
            <Label Text="Start Date:" Padding="20"  VerticalOptions="Center"/>
            <DatePicker x:Name="_pckStartDate"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout Margin="20"  Grid.Row="1" Grid.Column="1" HorizontalOptions="Center">
            <Label Text="End Date:" Padding="20"  VerticalOptions="Center"/>
            <DatePicker x:Name="_pckEndDate"/>
        </HorizontalStackLayout>
        <Border 
             Grid.Row="2"
            Grid.ColumnSpan="2"
             Margin="20"
             StrokeThickness="2"
             Stroke="#8FABD4">
            
            <CollectionView x:Name="_lstShoppingList"/>
        </Border>
    </Grid>
</ContentPage>