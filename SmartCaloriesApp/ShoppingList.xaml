<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SmartCaloriesApp.ShoppingList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <Grid Padding="32,24,32,40">

            <Frame
                Padding="32"
                BackgroundColor="{StaticResource CardBackground}"
                BorderColor="{StaticResource BorderColor}"
                CornerRadius="24"
                HasShadow="False"
                HorizontalOptions="Fill"
                MaximumWidthRequest="1100">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto , Auto" RowSpacing="20">

                    <!--  PAGE HEADER  -->
                    <VerticalStackLayout Grid.Row="0" Spacing="6">

                        <Label
                            FontAttributes="Bold"
                            FontSize="30"
                            Text="Shopping List"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            FontSize="14"
                            Text="Choose a date range to generate the ingredients you need for your meal plan."
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!--  DATE RANGE SECTION  -->
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16">

                        <!--  START DATE  -->
                        <Frame
                            Padding="18"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Start Date"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{StaticResource TextPrimary}" />

                                <DatePicker
                                    x:Name="_pckStartDate"
                                    Format="MMM dd, yyyy"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    HorizontalOptions="Center"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!--  END DATE  -->
                        <Frame
                            Grid.Column="2"
                            Padding="18"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="End Date"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{StaticResource TextPrimary}" />

                                <DatePicker
                                    x:Name="_pckEndDate"
                                    Format="MMM dd, yyyy"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    HorizontalOptions="Center"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                    
                    <!--  SEARCH BUTTON  -->
                    <Button x:Name="_btnSearch"
                            Grid.Row="2"
                            Clicked="OnSearch"
                            Text="Search"/>

                    <!--  INFO BOX  -->
                    <Frame
                        Grid.Row="3"
                        Padding="18"
                        BackgroundColor="{StaticResource HeaderBackground}"
                        BorderColor="{StaticResource BorderColor}"
                        CornerRadius="18"
                        HasShadow="False">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="Smart Grocery Planning"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="Choose your date range to automatically build a well-organized shopping list from your meal plan."
                                TextColor="{StaticResource TextPrimary}" />

                        </VerticalStackLayout>
                    </Frame>

                    <!--  SHOPPING LIST  -->
                    <VerticalStackLayout Grid.Row="4" Spacing="10">

                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Generated List"
                            TextColor="{StaticResource TextPrimary}" />

                        <Frame
                            Padding="12"
                            BackgroundColor="{StaticResource PageBackground}"
                            BorderColor="{StaticResource BorderColor}"
                            CornerRadius="18"
                            HasShadow="False">

                            <CollectionView x:Name="_lstShoppingList" HeightRequest="420" />
                        </Frame>
                    </VerticalStackLayout>

                </Grid>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>